{
  "name": "social-scheduler",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "WikiTree's social media scheduler: schedules and posts pictures, videos and text to its accounts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "SEED_MANUAL_ACCOUNTS=off tsx --test test/*.test.ts",
    "brief": "tsx scripts/brief.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "package": "tsx scripts/package.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@atproto/api": "^0.29.1",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "express": "^5.2.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
